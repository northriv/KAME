# Ad-hoc microbench artifacts under tests/.  The cmake/qmake test suite
# uses fixed names (alloc_stress_test, transaction_*) and stays tracked;
# anything matching `tests/bench_*` is an experiment binary or source
# file used to tune the allocator against mimalloc / sys malloc and
# gets regenerated per run.  Excluded so paper-data collection doesn't
# pollute `git status`.
tests/bench_*
tests/bench_*.dSYM/

# qmake in-source build residue under tests/ (`qmake Makefile.<target>` runs
# leave generated Makefiles, .o and .qmake.stash beside the sources; the
# tracked Makefile.tests / Makefile.nidaqmx are hand-written and stay).
tests/*.o
tests/.qmake.stash
tests/Makefile.3level_mixed
tests/Makefile.asp
tests/Makefile.dyn
tests/Makefile.tx
tests/Makefile.*.bak
tests/Makefile.*.stash

# cmake/ctest output (CTest writes "Testing/Temporary/" with last-run
# logs).  Build-dir-local; never tracked.
Testing/

# KAME writes <script>.log next to any script it runs
tools/*.py.log

# The MCP server's interpreter (README "MCP setup"): a venv KAME's probe
# finds by walking up from the resource dir, plus the standalone CPython it
# is built from when the host has no suitable one.  Local, ~150 MB, and
# platform-specific -- never tracked.
/kame-mcp-venv/
/.uvpython/
